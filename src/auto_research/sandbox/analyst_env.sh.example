#!/bin/bash
# Headless analyst-environment template for the auto_research sandbox.
# Copy to `analyst_env.sh` (gitignored) and edit for your machine, or run `bash install.sh`
# which writes it for you. Sourced by PersistentSandbox via _source_ini_env(): analysis-only,
# no SSH agent, no gnome-keyring, no interactive conda activation. The sandbox invokes
# {analyze_env}/bin/python directly, so no PATH-level conda activation is needed.
#
# This worked example initializes an X-ray-astronomy stack (HEASoft + CALDB). A different
# domain replaces these lines with its own `source`/`export` boot commands (e.g. a spack
# `spack env activate`, an Lmod `module load`, a ROS `source setup.bash`, etc.).

# HEAsoft — edit HEADAS to your install prefix.
export HEADAS=/opt/heasoft/heasoft-6.34/x86_64-pc-linux-gnu-libc2.34
. "$HEADAS/headas-init.sh"

# CALDB — edit CALDB to your calibration-database root.
export CALDB=/path/to/CALDB
export CALDBCONFIG="$CALDB/software/tools/caldb.config"
export CALDBALIAS="$CALDB/software/tools/alias_config.fits"
export GEOMAG_PATH="$CALDB/data/gen/pcf/geomag"
