# auto_research environment template.
# Copy to .env (gitignored) and fill in real values:  cp .env.example .env
# .env is loaded automatically by run_research(), the CLI, and `langgraph dev`.

# ── LLM providers ───────────────────────────────────────────────────────────
# Read directly by the provider SDKs (AsyncAnthropic / AsyncOpenAI / genai.Client).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...                 # Gemini; GEMINI_API_KEY also accepted by the SDK

# Optional second key per provider. On a rate limit or a spent balance the run switches to
# it immediately instead of waiting — both are quotas of the key, which a cooldown cannot
# refill. Use a key from a DIFFERENT organization: rate limits are per-organization, so a
# same-org key rotates onto the same exhausted bucket. Preflight rejects one that is blank
# or identical to the primary. Anthropic and OpenAI rotate; Google does not (its documented
# error vocabulary cannot be cited, so no rule is guessed for it).
# ANTHROPIC_API_KEY_FALLBACK=sk-ant-...
# OPENAI_API_KEY_FALLBACK=sk-...

# ── Vendor keys (required only when a role is configured with that vendor) ──
# The launch check derives what it demands from `config/models.yaml`: a member's `key_env`, or
# else its provider's own variable below. Legal harness/provider pairings and their documented
# endpoints are in sandbox/coder/harness.py.
# DEEPSEEK_API_KEY=sk-...            # DeepSeek (Codex: api.deepseek.com)
# ZAI_API_KEY=...                    # Z.AI GLM (Codex: api.z.ai/api/v1)
# DASHSCOPE_API_KEY=sk-...           # Alibaba Model Studio / Qwen (Codex: compatible-mode/v1)

# ── Literature sources ──────────────────────────────────────────────────────
ADS_DEV_KEY=...                    # NASA ADS token (ADS_API_TOKEN also honored)
TAVILY_API_KEY=tvly-...            # Tavily web search

# ── Raise-to-human connectors (optional, §9.8) ──────────────────────────────
# Only needed when a run selects that channel (human_channel / run_research(human_channel=…)
# or the CLI --human flag). The attended-terminal (cli) channel needs no keys.
# WhatsApp via Twilio (numbers may include or omit the "whatsapp:" prefix):
TWILIO_ACCOUNT_SID=AC...             # account the API key belongs to
TWILIO_API_KEY_SID=SK...             # API key SID (Console > Account > API keys & tokens)
TWILIO_API_KEY_SECRET=...            # the key secret, shown only once at creation
TWILIO_WHATSAPP_FROM=+14155238886    # your Twilio WhatsApp sender (sandbox or number)
WHATSAPP_TO=+1...                     # the human's WhatsApp number
# Telegram via long polling (RECOMMENDED — outbound-only, no public URL, reconnect-lossless):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF... # bot token from @BotFather
# TELEGRAM_CHAT_ID=123456789           # your chat id (send /start to the bot, then read getUpdates)
# Slack via Socket Mode (chronically unreliable on long runs — prefer Telegram):
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_HUMAN_CHANNEL=C0...            # channel id to post clarifications into

# ── Observability (optional) ────────────────────────────────────────────────
# Leave tracing off unless you want LangSmith traces; cost logging works regardless.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2-...
LANGCHAIN_PROJECT=auto_research

# ── Runtime data dir ─────────────────────────────────────────────────────────
# Configured in config/orchestration.yaml (runtime_dir / papers_dir keys), not here.
