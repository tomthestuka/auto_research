# auto_research environment template.
# Copy to .env (gitignored) and fill in real values:  cp .env.example .env
# .env is loaded automatically by run_research(), the CLI, and `langgraph dev`.

# ── LLM providers ───────────────────────────────────────────────────────────
# Read directly by the provider SDKs (AsyncAnthropic / AsyncOpenAI / genai.Client).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...                 # Gemini; GEMINI_API_KEY also accepted by the SDK

# ── Literature sources ──────────────────────────────────────────────────────
ADS_DEV_KEY=...                    # NASA ADS token (ADS_API_TOKEN also honored)
TAVILY_API_KEY=tvly-...            # Tavily web search

# ── Raise-to-human connectors (optional, §9.8) ──────────────────────────────
# Only needed when a run selects that channel (human_channel / run_research(human_channel=…)
# or the CLI --human flag). The attended-terminal (cli) channel needs no keys.
# WhatsApp via Twilio (numbers may include or omit the "whatsapp:" prefix):
TWILIO_ACCOUNT_SID=AC...             # account the API key belongs to
TWILIO_API_KEY_SID=SK...             # API key SID (Console > Account > API keys & tokens)
TWILIO_API_KEY_SECRET=...            # the key secret, shown only once at creation
TWILIO_WHATSAPP_FROM=+14155238886    # your Twilio WhatsApp sender (sandbox or number)
WHATSAPP_TO=+1...                     # the human's WhatsApp number
# Slack via Socket Mode:
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_HUMAN_CHANNEL=C0...            # channel id to post clarifications into

# ── Observability (optional) ────────────────────────────────────────────────
# Leave tracing off unless you want LangSmith traces; cost logging works regardless.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2-...
LANGCHAIN_PROJECT=auto_research

# ── Runtime data dir ─────────────────────────────────────────────────────────
# Configured in config/orchestration.yaml (runtime_dir key), not here.
# Optional: directory of locally supplied PDFs to ingest. Defaults under the runtime dir.
# AUTO_RESEARCH_PAPERS_DIR=/path/you/can/write/ar_runtime/papers
