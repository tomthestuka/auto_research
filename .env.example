# auto_research environment template.
# Copy to .env (gitignored) and fill in real values:  cp .env.example .env
# .env is loaded automatically by run_research(), the CLI, and `langgraph dev`.

# ── LLM providers ───────────────────────────────────────────────────────────
# Read directly by the provider SDKs (AsyncAnthropic / AsyncOpenAI / genai.Client).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...                 # Gemini; GEMINI_API_KEY also accepted by the SDK

# ── Literature sources ──────────────────────────────────────────────────────
ADS_DEV_KEY=...                    # NASA ADS token (ADS_API_TOKEN also honored)
TAVILY_API_KEY=tvly-...            # Tavily web search

# ── Observability (optional) ────────────────────────────────────────────────
# Leave tracing off unless you want LangSmith traces; cost logging works regardless.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2-...
LANGCHAIN_PROJECT=auto_research

# ── Runtime data dir ─────────────────────────────────────────────────────────
# Configured in config/orchestration.yaml (runtime_dir key), not here.
# Optional: directory of locally supplied PDFs to ingest. Defaults under the runtime dir.
# AUTO_RESEARCH_PAPERS_DIR=/path/you/can/write/ar_runtime/papers
